<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sudoku.ui.GameController"
            stylesheets="@../css/styles.css">

    <!-- Center: Bảng Sudoku (sẽ được điều khiển bằng code) -->
    <center>
        <fx:include fx:id="sudokuBoard" source="sudoku-board.fxml"/>
    </center>

    <!-- Right: Các panel điều khiển -->
    <right>
        <VBox spacing="10" styleClass="right-panel">
            <HBox spacing="5" alignment="CENTER">
                <Label text="Algorithm:" styleClass="label"/>
                <fx:include fx:id="algorithmSelector" source="algorithm-selector.fxml"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER">
                <Label text="Difficulty:" styleClass="label"/>
                <fx:include fx:id="difficultySelector" source="difficulty-selector.fxml"/>
            </HBox>
            <Button text="NEW GAME" fx:id="newGameButton" styleClass="cyber-button"/>
            <fx:include fx:id="statsPanel" source="stats-panel.fxml"/>
            <fx:include fx:id="stepLogPanel" source="step-log-panel.fxml"/>
        </VBox>
    </right>

    <!-- Bottom: Control panel -->
    <bottom>
        <fx:include fx:id="controlPanel" source="control-panel.fxml"/>
    </bottom>
</BorderPane>