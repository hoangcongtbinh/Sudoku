<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.sudoku.ui.SudokuBoard?>
<?import com.sudoku.ui.AlgorithmSelector?>
<?import com.sudoku.ui.DifficultySelector?>
<?import com.sudoku.ui.StatsPanel?>
<?import com.sudoku.ui.StepLogPanel?>
<?import com.sudoku.ui.ControlPanel?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sudoku.ui.GameController"
            stylesheets="@../css/styles.css">

    <!-- Center: Bảng Sudoku (sẽ được điều khiển bằng code) -->
    <center>
        <SudokuBoard fx:id="sudokuBoard"/>
    </center>

    <!-- Right: Các panel điều khiển -->
    <right>
        <VBox spacing="10" styleClass="right-panel" alignment="TOP_CENTER" prefWidth="250">
            <HBox spacing="5" alignment="CENTER">
                <Label text="Algorithm:" styleClass="label"/>
                <AlgorithmSelector fx:id="algorithmSelector"/>
            </HBox>
            <HBox spacing="5" alignment="CENTER">
                <Label text="Difficulty:" styleClass="label"/>
                <DifficultySelector fx:id="difficultySelector"/>
            </HBox>
            <Button text="NEW GAME" fx:id="newGameButton" styleClass="cyber-button"/>
            <StatsPanel fx:id="statsPanel"/>
            <StepLogPanel fx:id="stepLogPanel"/>
        </VBox>
    </right>

    <!-- Bottom: Control panel -->
    <bottom>
        <ControlPanel fx:id="controlPanel"/>
    </bottom>
</BorderPane>